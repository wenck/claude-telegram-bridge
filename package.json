{
  "name": "claude-telegram-bridge",
  "version": "1.0.0",
  "description": "A single-user Telegram bridge for Claude Code",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenck/claude-telegram-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/wenck/claude-telegram-bridge/issues"
  },
  "homepage": "https://github.com/wenck/claude-telegram-bridge#readme",
  "main": "bridge.js",
  "scripts": {
    "start": "node bridge.js",
    "check": "node --check bridge.js",
    "dry-run": "BRIDGE_DRY_RUN=1 BRIDGE_DRY_RUN_ONCE=1 BRIDGE_STATE_DIR=.dry-run-state node bridge.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "dotenv": "^17.2.1",
    "telegramify-markdown": "^1.3.3"
